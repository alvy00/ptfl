{
  "include": ["**/*.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],

    /* Bundler mode — matches the root tsconfig.json's resolution style so
       import syntax/aliases behave consistently, even though this covers
       a different runtime (Node, not browser). */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* One level up from this file's own location (api/), unlike the root
       config's "./src/*" — same alias, path adjusted for where this
       config actually sits. */
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
